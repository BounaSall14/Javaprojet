<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Tableau de bord — Statistiques temps reel -->
<VBox
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="fr.miage.sgpa.controller.HomeController"
    style="-fx-background-color: #F4F7F5; -fx-padding: 32px;"
    spacing="6">

    <!-- En-tete -->
    <Label text="Tableau de bord" styleClass="label-header"/>
    <Label text="Vue d ensemble de la pharmacie en temps reel"
           style="-fx-text-fill: #6B7280; -fx-font-size: 14px;"/>

    <Region prefHeight="16"/>

    <!-- Ligne de cartes KPI -->
    <HBox spacing="18" alignment="CENTER_LEFT">

        <!-- Medicaments -->
        <VBox styleClass="kpi-card" prefWidth="220" alignment="CENTER" spacing="10">
            <Label text="Medicaments"
                   style="-fx-font-weight: bold; -fx-text-fill: #2E7D32; -fx-font-size: 12.5px; -fx-letter-spacing: 0.5;"/>
            <Label fx:id="statMedicamentsLabel" text="..."
                   style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #1B5E20;"/>
            <Label text="references en catalogue"
                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;"/>
            <Region prefHeight="4"/>
            <HBox alignment="CENTER">
                <Label text="CATALOGUE"
                       style="-fx-background-color: #D1FAE5; -fx-text-fill: #065F46;
                              -fx-font-size: 10px; -fx-font-weight: bold;
                              -fx-background-radius: 20; -fx-padding: 3 10 3 10;"/>
            </HBox>
        </VBox>

        <!-- Ventes -->
        <VBox styleClass="kpi-card" prefWidth="220" alignment="CENTER" spacing="10">
            <Label text="Ventes"
                   style="-fx-font-weight: bold; -fx-text-fill: #1565C0; -fx-font-size: 12.5px;"/>
            <Label fx:id="statVentesLabel" text="..."
                   style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #0D47A1;"/>
            <Label text="transactions enregistrees"
                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;"/>
            <Region prefHeight="4"/>
            <HBox alignment="CENTER">
                <Label text="VENTES"
                       style="-fx-background-color: #DBEAFE; -fx-text-fill: #1E40AF;
                              -fx-font-size: 10px; -fx-font-weight: bold;
                              -fx-background-radius: 20; -fx-padding: 3 10 3 10;"/>
            </HBox>
        </VBox>

        <!-- Stock bas -->
        <VBox styleClass="kpi-card-warn" prefWidth="220" alignment="CENTER" spacing="10">
            <Label text="Alertes Stock"
                   style="-fx-font-weight: bold; -fx-text-fill: #92400E; -fx-font-size: 12.5px;"/>
            <Label fx:id="statStockLabel" text="..."
                   style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #78350F;"/>
            <Label text="articles sous seuil minimum"
                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;"/>
            <Region prefHeight="4"/>
            <HBox alignment="CENTER">
                <Label text="STOCK FAIBLE"
                       style="-fx-background-color: #FEF3C7; -fx-text-fill: #92400E;
                              -fx-font-size: 10px; -fx-font-weight: bold;
                              -fx-background-radius: 20; -fx-padding: 3 10 3 10;"/>
            </HBox>
        </VBox>

        <!-- Peremption -->
        <VBox styleClass="kpi-card-danger" prefWidth="220" alignment="CENTER" spacing="10">
            <Label text="Peremption proche"
                   style="-fx-font-weight: bold; -fx-text-fill: #6B21A8; -fx-font-size: 12.5px;"/>
            <Label fx:id="statPeremptionLabel" text="..."
                   style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #581C87;"/>
            <Label text="expirent dans moins de 3 mois"
                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;"/>
            <Region prefHeight="4"/>
            <HBox alignment="CENTER">
                <Label text="A SURVEILLER"
                       style="-fx-background-color: #F3E8FF; -fx-text-fill: #6B21A8;
                              -fx-font-size: 10px; -fx-font-weight: bold;
                              -fx-background-radius: 20; -fx-padding: 3 10 3 10;"/>
            </HBox>
        </VBox>

    </HBox>

    <!-- Section indicative (aucune donnee, juste visuel) -->
    <Region prefHeight="20"/>
    <Label text="Legende des couleurs dans le tableau Medicaments"
           style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 13px;"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="  PERIME  "
               style="-fx-background-color: #FEE2E2; -fx-text-fill: #991B1B;
                      -fx-font-size: 12px; -fx-font-weight: bold;
                      -fx-background-radius: 6; -fx-padding: 5 12 5 12;"/>
        <Label text="  BIENTOT PERIME  "
               style="-fx-background-color: #F3E8FF; -fx-text-fill: #6B21A8;
                      -fx-font-size: 12px; -fx-font-weight: bold;
                      -fx-background-radius: 6; -fx-padding: 5 12 5 12;"/>
        <Label text="  STOCK FAIBLE  "
               style="-fx-background-color: #FFEDD5; -fx-text-fill: #92400E;
                      -fx-font-size: 12px; -fx-font-weight: bold;
                      -fx-background-radius: 6; -fx-padding: 5 12 5 12;"/>
    </HBox>

</VBox>
