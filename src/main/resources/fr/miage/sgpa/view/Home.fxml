<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="SGPA Pharmacie - Tableau de bord" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
    <Label text="Bienvenue dans votre outil de gestion." style="-fx-font-size: 16;"/>

    <HBox spacing="20" alignment="CENTER">
        <VBox style="-fx-background-color: #e3f2fd; -fx-padding: 20; -fx-background-radius: 10;" prefWidth="200" alignment="CENTER">
            <Label text="Médicaments" style="-fx-font-weight: bold;"/>
            <Label text="Gérez votre catalogue"/>
        </VBox>
        <VBox style="-fx-background-color: #f1f8e9; -fx-padding: 20; -fx-background-radius: 10;" prefWidth="200" alignment="CENTER">
            <Label text="Ventes" style="-fx-font-weight: bold;"/>
            <Label text="Enregistrez de nouvelles transactions"/>
        </VBox>
        <VBox style="-fx-background-color: #fff3e0; -fx-padding: 20; -fx-background-radius: 10;" prefWidth="200" alignment="CENTER">
            <Label text="Stocks" style="-fx-font-weight: bold;"/>
            <Label text="Surveillez vos inventaires"/>
        </VBox>
    </HBox>
</VBox>
