<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.miage.sgpa.controller.MedicamentController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Label text="Gestion des Médicaments" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <TableView fx:id="medicamentTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nomCol" text="Nom Commercial" />
            <TableColumn fx:id="principeCol" text="Principe Actif" />
            <TableColumn fx:id="prixCol" text="Prix" />
            <TableColumn fx:id="stockCol" text="Stock" />
            <TableColumn fx:id="peremptionCol" text="Péremption" />
        </columns>
    </TableView>

    <GridPane hgap="10" vgap="5" fx:id="editForm">
        <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nomField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Prix:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="prixField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Stock:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="stockField" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="Seuil Min:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="seuilField" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <Label text="Péremption:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <DatePicker fx:id="peremptionPicker" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="4">
            <Button text="Ajouter" onAction="#handleAdd"/>
            <Button text="Modifier" onAction="#handleUpdate"/>
            <Button text="Supprimer" onAction="#handleDelete" style="-fx-text-fill: red;"/>
        </HBox>
    </GridPane>
</VBox>
