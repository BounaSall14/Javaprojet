<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<!-- Écran de connexion — thème blanc & vert pharmacie -->
<StackPane
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="fr.miage.sgpa.controller.LoginController"
    styleClass="login-scene">

    <!-- Carte de login centrée -->
    <VBox alignment="CENTER" spacing="24" styleClass="login-card"
          maxWidth="420" maxHeight="480">

        <!-- Logo / Titre -->
        <Label text="SGPA Pharmacie" styleClass="label-header">
            <font><Font name="System Bold" size="26"/></font>
        </Label>
        <Label text="Connectez-vous à votre espace" style="-fx-text-fill: #757575; -fx-font-size: 13px;"/>

        <!-- Formulaire -->
        <VBox spacing="12">
            <Label text="Nom d'utilisateur" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #424242;"/>
            <TextField fx:id="usernameField" promptText="Entrez votre identifiant"/>

            <Label text="Mot de passe" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #424242;"/>
            <PasswordField fx:id="passwordField" promptText="••••••••"/>
        </VBox>

        <!-- Bouton + feedback -->
        <Button fx:id="loginButton" onAction="#handleLogin"
                text="Se connecter" maxWidth="Infinity"
                style="-fx-font-size: 14px; -fx-padding: 12px 18px;"/>

        <ProgressIndicator fx:id="progressIndicator" visible="false"
                           prefHeight="32" prefWidth="32"/>

        <Label fx:id="errorLabel" styleClass="label-error"
               wrapText="true" textAlignment="CENTER" maxWidth="360"/>
    </VBox>
</StackPane>
