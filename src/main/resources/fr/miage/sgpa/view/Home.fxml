<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="fr.miage.sgpa.controller.HomeController"
    style="-fx-background-color: #F4F7F5; -fx-padding: 28px;"
    spacing="6">

    <Label text="Tableau de bord" styleClass="label-header"/>
    <Label text="Vue d ensemble en temps reel"
           style="-fx-text-fill: #6B7280; -fx-font-size: 14px;"/>

    <Region prefHeight="12"/>

    <!-- Cartes KPI -->
    <HBox spacing="16" alignment="CENTER_LEFT">

        <VBox styleClass="kpi-card" prefWidth="210" alignment="CENTER" spacing="8">
            <Label text="Medicaments"
                   style="-fx-font-weight:bold; -fx-text-fill:#2E7D32; -fx-font-size:12px;"/>
            <Label fx:id="statMedicamentsLabel" text="..."
                   style="-fx-font-size:38px; -fx-font-weight:bold; -fx-text-fill:#1B5E20;"/>
            <Label text="references catalogue"
                   style="-fx-text-fill:#9CA3AF; -fx-font-size:11px;"/>
        </VBox>

        <VBox styleClass="kpi-card" prefWidth="210" alignment="CENTER" spacing="8">
            <Label text="Ventes"
                   style="-fx-font-weight:bold; -fx-text-fill:#1565C0; -fx-font-size:12px;"/>
            <Label fx:id="statVentesLabel" text="..."
                   style="-fx-font-size:38px; -fx-font-weight:bold; -fx-text-fill:#0D47A1;"/>
            <Label text="transactions"
                   style="-fx-text-fill:#9CA3AF; -fx-font-size:11px;"/>
        </VBox>

        <VBox styleClass="kpi-card-warn" prefWidth="210" alignment="CENTER" spacing="8">
            <Label text="Alertes stock"
                   style="-fx-font-weight:bold; -fx-text-fill:#92400E; -fx-font-size:12px;"/>
            <Label fx:id="statStockLabel" text="..."
                   style="-fx-font-size:38px; -fx-font-weight:bold; -fx-text-fill:#78350F;"/>
            <Label text="sous seuil min"
                   style="-fx-text-fill:#9CA3AF; -fx-font-size:11px;"/>
        </VBox>

        <VBox styleClass="kpi-card-danger" prefWidth="210" alignment="CENTER" spacing="8">
            <Label text="Peremption proche"
                   style="-fx-font-weight:bold; -fx-text-fill:#6B21A8; -fx-font-size:12px;"/>
            <Label fx:id="statPeremptionLabel" text="..."
                   style="-fx-font-size:38px; -fx-font-weight:bold; -fx-text-fill:#581C87;"/>
            <Label text="dans moins de 3 mois"
                   style="-fx-text-fill:#9CA3AF; -fx-font-size:11px;"/>
        </VBox>

    </HBox>

    <Region prefHeight="18"/>

    <!-- Section PERIMES : medicaments a enlever du stock -->
    <VBox spacing="8"
          style="-fx-background-color:#FFFFFF; -fx-background-radius:12;
                 -fx-border-color:#FCA5A5; -fx-border-radius:12; -fx-border-width:1.5;
                 -fx-padding:18; -fx-effect:dropshadow(gaussian,rgba(220,38,38,0.12),10,0,0,3);">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Medicaments a enlever du stock"
                   style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#991B1B;"/>
            <Label fx:id="perimesCountLabel" text=""
                   style="-fx-background-color:#FEE2E2; -fx-text-fill:#991B1B;
                          -fx-font-size:11px; -fx-font-weight:bold;
                          -fx-background-radius:20; -fx-padding:3 10 3 10;"/>
        </HBox>

        <Label text="Ces medicaments ont depasse leur date de peremption. Ils doivent etre retires du stock."
               style="-fx-text-fill:#6B7280; -fx-font-size:12px;"/>

        <TableView fx:id="perimesTable" prefHeight="180">
            <columns>
                <TableColumn fx:id="perimesNomCol"   text="Medicament"       prefWidth="260"/>
                <TableColumn fx:id="perimesDateCol"  text="Date peremption"  prefWidth="160"/>
                <TableColumn fx:id="perimesStockCol" text="Stock restant"     prefWidth="120"/>
            </columns>
        </TableView>

    </VBox>

    <Region prefHeight="10"/>

    <!-- Legende couleurs -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Legende :" style="-fx-font-weight:bold; -fx-text-fill:#374151;"/>
        <Label text="  PERIME  "
               style="-fx-background-color:#FEE2E2; -fx-text-fill:#991B1B; -fx-font-weight:bold;
                      -fx-background-radius:6; -fx-padding:4 10 4 10; -fx-font-size:11px;"/>
        <Label text="  BIENTOT PERIME  "
               style="-fx-background-color:#F3E8FF; -fx-text-fill:#6B21A8; -fx-font-weight:bold;
                      -fx-background-radius:6; -fx-padding:4 10 4 10; -fx-font-size:11px;"/>
        <Label text="  STOCK FAIBLE  "
               style="-fx-background-color:#FFEDD5; -fx-text-fill:#92400E; -fx-font-weight:bold;
                      -fx-background-radius:6; -fx-padding:4 10 4 10; -fx-font-size:11px;"/>
    </HBox>

</VBox>
