<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.miage.sgpa.controller.CommandeController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Label text="Gestion des Commandes" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <TabPane VBox.vgrow="ALWAYS">
        <Tab text="Liste des Commandes" closable="false">
            <VBox spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <TableView fx:id="commandeTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idCol" text="ID" />
                        <TableColumn fx:id="fournisseurCol" text="Fournisseur" />
                        <TableColumn fx:id="dateCol" text="Date" />
                        <TableColumn fx:id="statutCol" text="Statut" />
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_LEFT" fx:id="adminControls">
                    <Button text="Réceptionner la commande" onAction="#handleReception" style="-fx-background-color: blue; -fx-text-fill: white;"/>
                </HBox>
            </VBox>
        </Tab>
        <Tab text="Nouvelle Commande" closable="false" fx:id="newOrderTab">
            <VBox spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Fournisseur:"/>
                    <ComboBox fx:id="fournisseurCombo" prefWidth="200"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Médicament:"/>
                    <ComboBox fx:id="medicamentCombo" prefWidth="200"/>
                    <Label text="Quantité:"/>
                    <TextField fx:id="quantiteField" prefWidth="50" text="10"/>
                    <Button text="Ajouter à la commande" onAction="#addToOrder"/>
                </HBox>
                <TableView fx:id="newLignesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="newMedCol" text="Médicament" />
                        <TableColumn fx:id="newQtyCol" text="Quantité" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT">
                    <Button text="Passer la commande" onAction="#handleCreateOrder" style="-fx-background-color: green; -fx-text-fill: white;"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
