<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="14"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="fr.miage.sgpa.controller.MedicamentController"
    style="-fx-background-color: #F5F5F5; -fx-padding: 20px;">

    <Label text="Gestion des Medicaments" styleClass="label-title"/>

    <!-- Tableau des medicaments -->
    <TableView fx:id="medicamentTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nomCol"        text="Nom Commercial"  prefWidth="200"/>
            <TableColumn fx:id="principeCol"   text="Principe Actif"  prefWidth="170"/>
            <TableColumn fx:id="prixCol"       text="Prix (EUR)"      prefWidth="90"/>
            <TableColumn fx:id="stockCol"      text="Stock"           prefWidth="80"/>
            <TableColumn fx:id="peremptionCol" text="Peremption"      prefWidth="120"/>
        </columns>
    </TableView>

    <!-- Formulaire ajouter / modifier -->
    <GridPane fx:id="editForm" hgap="14" vgap="10"
              style="-fx-background-color: #FFFFFF; -fx-padding: 16; -fx-background-radius: 8;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">

        <Label text="Nom :"
               GridPane.columnIndex="0" GridPane.rowIndex="0"
               style="-fx-font-weight:bold;"/>
        <TextField fx:id="nomField" promptText="Nom commercial"
                   GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200"/>

        <Label text="Prix (EUR) :"
               GridPane.columnIndex="0" GridPane.rowIndex="1"
               style="-fx-font-weight:bold;"/>
        <TextField fx:id="prixField" promptText="0.00"
                   GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="200"/>

        <Label text="Stock :"
               GridPane.columnIndex="2" GridPane.rowIndex="0"
               style="-fx-font-weight:bold;"/>
        <TextField fx:id="stockField" promptText="0"
                   GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="130"/>

        <Label text="Seuil min :"
               GridPane.columnIndex="2" GridPane.rowIndex="1"
               style="-fx-font-weight:bold;"/>
        <TextField fx:id="seuilField" promptText="0"
                   GridPane.columnIndex="3" GridPane.rowIndex="1" prefWidth="130"/>

        <Label text="Peremption :"
               GridPane.columnIndex="0" GridPane.rowIndex="2"
               style="-fx-font-weight:bold;"/>
        <DatePicker fx:id="peremptionPicker"
                    GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <HBox spacing="10"
              GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="4">
            <Button text="Ajouter"    onAction="#handleAdd"/>
            <Button text="Modifier"   onAction="#handleUpdate"
                    style="-fx-background-color: #1565C0; -fx-text-fill: white; -fx-background-radius: 8px;"/>
            <Button text="Supprimer"  onAction="#handleDelete"
                    style="-fx-background-color: #C62828; -fx-text-fill: white; -fx-background-radius: 8px;"/>
        </HBox>

    </GridPane>

</VBox>
