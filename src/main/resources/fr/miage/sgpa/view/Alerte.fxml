<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Alertes : table unifiée STOCK + PEREMPTION -->
<VBox spacing="14"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="fr.miage.sgpa.controller.AlerteController"
    style="-fx-background-color: #F5F5F5; -fx-padding: 20px;">

    <Label text="Alertes Stock et Peremption" styleClass="label-title"/>

    <Label fx:id="totalLabel" text="Chargement..."
           style="-fx-text-fill: #C62828; -fx-font-weight: bold; -fx-font-size: 13px;"/>

    <TableView fx:id="alerteTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="alerteNomCol"   text="Medicament"      prefWidth="200"/>
            <TableColumn fx:id="alerteStockCol" text="Stock actuel"     prefWidth="110"/>
            <TableColumn fx:id="alerteSeuilCol" text="Seuil minimum"    prefWidth="120"/>
            <TableColumn fx:id="alerteDateCol"  text="Date peremption"  prefWidth="140"/>
            <TableColumn fx:id="alerteTypeCol"  text="Type alerte"      prefWidth="130"/>
        </columns>
    </TableView>

</VBox>
