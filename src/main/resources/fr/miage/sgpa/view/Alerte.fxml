<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.miage.sgpa.controller.AlerteController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Label text="Alertes Stock et Péremption" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <VBox spacing="5" VBox.vgrow="ALWAYS">
        <Label text="Stock Bas" style="-fx-font-weight: bold;"/>
        <TableView fx:id="stockAlertTable">
            <columns>
                <TableColumn fx:id="stockNomCol" text="Médicament" />
                <TableColumn fx:id="stockActuelCol" text="Stock Actuel" />
                <TableColumn fx:id="stockSeuilCol" text="Seuil Min" />
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="5" VBox.vgrow="ALWAYS">
        <Label text="Péremption Proche (< 3 mois)" style="-fx-font-weight: bold;"/>
        <TableView fx:id="peremptionAlertTable">
            <columns>
                <TableColumn fx:id="peremptionNomCol" text="Médicament" />
                <TableColumn fx:id="peremptionDateCol" text="Date Péremption" />
            </columns>
        </TableView>
    </VBox>
</VBox>
